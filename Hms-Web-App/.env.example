# Copy this file to .env.local and edit if you need a different backend.
#
# THIS IS THE ONLY PLACE THE SERVER URL APPEARS. Application code uses relative
# paths only, so changing this one line repoints the whole app.
#
#   Deployed server (default) : http://139.59.46.163:8085
#   A laptop backend          : http://localhost:8085
VITE_PROXY_TARGET=http://139.59.46.163:8085

# How many results the patient / practitioner pickers request per search.
VITE_PICKER_PAGE_SIZE=20
